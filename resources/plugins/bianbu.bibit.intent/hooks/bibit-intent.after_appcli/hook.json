{
  "schema_version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*appcli_run",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_appcli.py\"",
            "timeout": 25,
            "mode": "resident"
          }
        ]
      }
    ]
  },
  "priority": 220
}
