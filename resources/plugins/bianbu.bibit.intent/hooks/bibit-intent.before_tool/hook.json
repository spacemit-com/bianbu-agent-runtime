{
  "schema_version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "set_volume",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/before_tool.py\"",
            "timeout": 5,
            "mode": "resident"
          }
        ]
      },
      {
        "matcher": "set_brightness",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/before_tool.py\"",
            "timeout": 5,
            "mode": "resident"
          }
        ]
      }
    ]
  },
  "priority": 200
}
