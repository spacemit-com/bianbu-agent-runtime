{
  "schema_version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "set_volume",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/before_tool.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "set_brightness",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/before_tool.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "priority": 200,
  "metadata": {
    "agent_selectable": true,
    "display_name": "Bibit ambiguous adjustment guard",
    "description": "Reject volume/brightness MCP calls when the user request does not name the target setting."
  },
  "parallel": true
}
