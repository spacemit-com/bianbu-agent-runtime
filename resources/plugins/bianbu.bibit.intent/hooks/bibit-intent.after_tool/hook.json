{
  "schema_version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_tool.py\"",
            "timeout": 25,
            "mode": "resident"
          }
        ]
      },
      {
        "matcher": "patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_tool.py\"",
            "timeout": 25,
            "mode": "resident"
          }
        ]
      }
    ]
  },
  "priority": 210
}
