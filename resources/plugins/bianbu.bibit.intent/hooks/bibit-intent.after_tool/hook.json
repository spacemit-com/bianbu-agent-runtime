{
  "schema_version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_tool.py\"",
            "timeout": 25
          }
        ]
      },
      {
        "matcher": "patch",
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_tool.py\"",
            "timeout": 25
          }
        ]
      }
    ]
  },
  "priority": 210,
  "metadata": {
    "agent_selectable": true,
    "display_name": "Bibit dependency notice",
    "description": "After a code write, ask Bibit (read-only) whether dependencies are missing and attach a short notice."
  },
  "parallel": true
}
