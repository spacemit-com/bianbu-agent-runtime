{
  "display_name": "Bibit Admin Tools",
  "transport": "stdio",
  "command": "/opt/bibit-intent/.venv/bin/python",
  "args": ["-m", "bibit_intent.mcp_server"],
  "env": {
    "PYTHONPATH": "/opt/bibit-intent/src",
    "BIBIT_MCP_TRANSPORT": "stdio",
    "BIBIT_MCP_GROUPS": "admin",
    "PATH": "/opt/bibit-intent/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
  }
}
