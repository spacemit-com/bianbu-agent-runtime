{
  "schema_version": 1,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${RUNTIME_PYTHON}\" \"$PLUGIN_ROOT/scripts/after_tool.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "parallel": true
}
