<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="30.3.14"><diagram name="概要设计 04：会话事件、持久化与客户端投影" id="04-events"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wrun" value="Worker：RunManager / LangGraphEngine&#xa;用户消息 · 推理 · 文本增量 · Tool · 审批 · inbox · 终态" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="70" y="70" width="460" height="80" as="geometry"/></mxCell><mxCell id="store" value="SessionLogStore（每个 Session 独立的连续 seq 日志）&#xa;JSONL 追加 + SQLite 投影 · write-behind 落盘" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="70" width="460" height="80" as="geometry"/></mxCell><mxCell id="commit" value="已提交事件（唯一权威来源）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1130" y="70" width="420" height="80" as="geometry"/></mxCell><mxCell id="h" value="GET /api/v1/sessions/{id}/events&#xa;?cursor= · 历史分页回放" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="250" width="250" height="90" as="geometry"/></mxCell><mxCell id="mux" value="WS /api/v1/events/mux&#xa;一条连接推送所有 Session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="250" height="90" as="geometry"/></mxCell><mxCell id="host" value="WS /api/v1/events/host&#xa;会话列表与运行状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1140" y="250" width="250" height="90" as="geometry"/></mxCell><mxCell id="window" value="客户端事件窗口&#xa;按 seq 去重 · 发现缺口后重新拉取权威历史" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="420" width="460" height="80" as="geometry"/></mxCell><mxCell id="vm" value="每 Session 独立 ViewModel&#xa;同一事件窗口消费历史 + 实时事件" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="540" width="460" height="80" as="geometry"/></mxCell><mxCell id="chat" value="Chat 投影&#xa;面向对话阅读" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="380" y="680" width="320" height="80" as="geometry"/></mxCell><mxCell id="traj" value="Trajectory 投影&#xa;按 Run 轮次：用户输入 / 推理 / 助手输出 /&#xa;Tool / 审批 / 上下文压缩 / 终态" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="400" height="80" as="geometry"/></mxCell><mxCell id="others" value="其他存储（职责独立，不能互相替代）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbfbfe;strokeColor=#9aa4c7;fontSize=15;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="70" y="830" width="1480" height="140" as="geometry"/></mxCell><mxCell id="o1" value="JSONSessionStore&#xa;会话身份 · 标题 · thread 绑定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="875" width="340" height="70" as="geometry"/></mxCell><mxCell id="o2" value="LangGraph Checkpoint（SQLite）&#xa;图状态 · 中断与恢复" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="470" y="875" width="340" height="70" as="geometry"/></mxCell><mxCell id="o3" value="ProviderCaptureStore&#xa;模型请求 / 响应捕获" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="840" y="875" width="340" height="70" as="geometry"/></mxCell><mxCell id="o4" value="RuntimeLogStore&#xa;运行期结构化日志" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1210" y="875" width="310" height="70" as="geometry"/></mxCell><mxCell id="note" value="旧 /messages、Session SSE、Run SSE 已删除；历史与实时只经过同一个客户端事件窗口，因此刷新与切换会话得到相同投影，切换页面不会停止后台任务。" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="70" y="995" width="1480" height="60" as="geometry"/></mxCell><mxCell id="g0" value="RunEvent(seq)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wrun" target="store"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g1" value="提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="store" target="commit"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="g2" value="权威历史" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" 