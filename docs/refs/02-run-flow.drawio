<mxfile host="drawio" version="30.3.14"><diagram name="概要设计 02：一次 Run 的执行流程与 8 个 Hook 点" id="02-run-flow"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="1580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="POST /api/v1/sessions/{session_id}/prompt" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="30" width="420" height="56" as="geometry"/></mxCell><mxCell id="broker" value="SessionInputBroker&#xa;按会话加锁 · message_id 去重 · 写入 next-step FIFO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="420" height="70" as="geometry"/></mxCell><mxCell id="run" value="RunManager.run()&#xa;租用 PluginGeneration · 创建 RunControl（取消 + 审批通道）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="225" width="420" height="70" as="geometry"/></mxCell><mxCell id="h1" value="① before_run Hook（可短路）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="330" width="420" height="50" as="geometry"/></mxCell><mxCell id="dreply" value="有 direct_reply？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="415" width="280" height="90" as="geometry"/></mxCell><mxCell id="h2" value="② after_context Hook&#xa;与 before_run 的 ContextPatch 合并为 prompt" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="540" width="420" height="62" as="geometry"/></mxCell><mxCell id="build" value="engine_builder(agent, generation, model)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="637" width="420" height="50" as="geometry"/></mxCell><mxCell id="create" value="create_agent(model, tools, system_prompt, checkpointer,&#xa;middleware=[QueuedSteering, HumanInTheLoop])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="722" width="420" height="62" as="geometry"/></mxCell><mxCell id="h3" value="③ before_model Hook（DLP 改写模型输入）" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="820" width="420" height="50" as="geometry"/></mxCell><mxCell id="llm" value="LLM 流式推理（每次调用前检查上下文容量并压缩）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="905" width="420" height="50" as="geometry"/></mxCell><mxCell id="h4" value="④ after_model Hook" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="990" width="420" height="50" as="geometry"/></mxCell><mxCell id="dtool" value="有 Tool 调用？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="270" y="1075" width="280" height="90" as="geometry"/></mxCell><mxCell id="h7" value="⑦ after_run Hook" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="1220" width="420" height="50" as="geometry"/></mxCell><mxCell id="result" value="RunResult / RunError 落库（按 Run 轮次）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="1305" width="420" height="56" as="geometry"/></mxCell><mxCell id="events" value="SessionLogStore 事件投影&#xa;GET /sessions/{id}/events · WS /api/v1/events/mux" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="1396" width="420" height="62" as="geometry"/></mxCell><mxCell id="direct" value="直接回复&#xa;写入会话历史 + 发布 token 事件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="425" width="420" height="70" as="geometry"/></mxCell><mxCell id="h5" value="⑤ before_tool Hook" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="820" width="460" height="50" as="geometry"/></mxCell><mxCell id="sec" value="安全与审批检查&#xa;caller 校验 · 权限 · DLP · 网络策略" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="905" width="460" height="65" as="geometry"/></mxCell><mxCell id="dappr" value="需要审批？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="920" y="1005" width="260" height="95" as="geometry"/></mxCell><mxCell id="approve" value="等待用户批准&#xa;WS approval.request → POST approvals/{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="1140" width="460" height="65" as="geometry"/></mxCell><mxCell id="exec" value="工具执行&#xa;内置 / 目录工具 / MCP / 子 Agent" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="1240" width="460" height="65" as="geometry"/></mxCell><mxCell id="trim" value="结果裁剪（回到上下文预算内）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#5b6bbf;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="1340" width="460" height="50" as="geometry"/></mxCell><mxCell id="h6" value="⑥ after_tool Hook" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="1428" width="460" height="50" as="geometry"/></mxCell><mxCell id="err" value="⑧ on_error Hook&#xa;异常分类 · 绝不当作成功完成" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e8f7ec;strokeColor=#4c9a63;fontSize=13;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="1350" y="905" width="380" height="80" as="geometry"/></mxCell><mxCell id="f0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="broker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="broker" target="run"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f2" value="" style="