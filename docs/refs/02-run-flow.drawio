 target="exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f21" value="否：直接执行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dappr" target="exec"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1052"/></Array></mxGeometry></mxCell><mxCell id="f22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exec" target="trim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="trim" target="h6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f24" value="循环：直到无工具调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h6" target="h3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="1453"/><mxPoint x="140" y="845"/></Array></mxGeometry></mxCell><mxCell id="f25" value="拒绝" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sec" target="err"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f26" value="否决 / 超时" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jettySize=auto;html=1;fontSize=12;strokeColor=#4d5b8a;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dappr" target="err"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1330" y="1086"/></Array></mxGeometry></mxCell><mxCell id="legend" value="图例：绿色圆角 = 插件 Hook 点（before_run / after_context / before_model / after_model / before_tool / after_tool / after_run / on_error）；黄色菱形 = 分支判断；虚线 = 异常或拒绝路径。&#xa;取消与异常都进入收尾，压缩、审批和子 Agent 都不结束 Run；一个会话只按显式用户轮次推进。" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="200" y="1500" width="1240" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
