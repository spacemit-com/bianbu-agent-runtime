#!/usr/bin/make -f

export PYBUILD_NAME = bianbu-agent-runtime
export UV_NO_PROGRESS = 1
export UV_SYSTEM_CERTS = 1
export PYTHONDONTWRITEBYTECODE = 1

PACKAGE := bianbu-agent-runtime
BUILD_ROOT := $(CURDIR)/debian/.bianbu-agent-build
BUILD_VENV := $(BUILD_ROOT)/venv
EXTRA_REQUIREMENTS := $(CURDIR)/debian/requirements-extra.txt
PACKAGE_ROOT := $(CURDIR)/debian/$(PACKAGE)
RUNTIME_PYTHON := /usr/bin/python3.14
UV := python3 -m uv
DEB_HOST_ARCH ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
SQLITE_VEC_WHEEL := $(BUILD_ROOT)/sqlite_vec-0.1.9-py3-none-manylinux_2_43_riscv64.whl
SQLITE_VEC_URL := https://git.spacemit.com/api/v4/projects/33/packages/pypi/files/45c3e2d7b38c98e6e1ceee745d605c18276c7d1bd5ffc69e3ddbbef72605e0ca/sqlite_vec-0.1.9-py3-none-manylinux_2_41_riscv64.whl
SQLITE_VEC_SHA256 := 45c3e2d7b38c98e6e1ceee745d605c18276c7d1bd5ffc69e3ddbbef72605e0ca
# browser_* Tools shell out to `agent-browser` on PATH; the CLI, its wrapper
# and its Chromium dependency come from the separate agent-browser package
# (gitlab.dc.com/bianbu/ai/agent-browser), so this build no longer compiles Rust.

PACKAGE_ROOT := $(CURDIR)/debian/$(PACKAGE)

%:
	dh $@

override_dh_auto_clean:
	rm -rf "$(BUILD_ROOT)"
	dh_auto_clean

override_dh_auto_build:
	mkdir -p "$(BUILD_ROOT)"
	if ! $(UV) --version 2>/dev/null | grep -Eq '^uv 0\.11\.'; then \
		python3 -m pip install 'uv>=0.11,<0.12' \
			--index-url https://nexus.bianbu.xyz/repository/pypi/simple \
			--trusted-host nexus.bianbu.xyz --break-system-packages --prefer-binary; \
	fi
	mkdir -p "$(BUILD_ROOT)"
	if [ "$(DEB_HOST_ARCH)" = riscv64 ]; then \
		curl -fsSL --retry 3 "$(SQLITE_VEC_URL)" -o "$(SQLITE_VEC_WHEEL)"; \
		printf '%s  %s\n' "$(SQLITE_VEC_SHA256)" "$(SQLITE_VEC_WHEEL)" | sha256sum -c -; \
	fi
	$(UV) venv --clear --relocatable --system-site-packages --python "$(RUNTIME_PYTHON)" "$(BUILD_VENV)"
	if [ "$(DEB_HOST_ARCH)" = riscv64 ]; then \
		UV_PROJECT_ENVIRONMENT="$(BUILD_VENV)" $(UV) sync --locked --no-dev \
			--no-install-project --no-install-package sqlite-vec \
			--python "$(BUILD_VENV)/bin/python"; \
	else \
		UV_PROJECT_ENVIRONMENT="$(BUILD_VENV)" $(UV) sync --locked --no-dev \
			--no-install-project --python "$(BUILD_VENV)/bin/python"; \
	fi
	$(UV) pip install --python "$(BUILD_VENV)/bin/python" -r "$(EXTRA_REQUIREMENTS)"
	if [ "$(DEB_HOST_ARCH)" = riscv64 ]; then \
		$(UV) pip install --python "$(BUILD_VENV)/bin/python" "$(SQLITE_VEC_WHEEL)"; \
	fi
	# Build the project with the hatchling supplied by Build-Depends. The venv
	# is created with --system-site-packages, so --no-build-isolation keeps the
	# local wheel build independent of the package index. --reinstall replaces
	# an already-installed copy even when the version did not change.
	$(UV) pip install --python "$(BUILD_VENV)/bin/python" --no-deps --reinstall --no-build-isolation .
	find "$(BUILD_VENV)" -type d -name __pycache__ -prune -exec rm -rf '{}' +
	rm -f "$(BUILD_VENV)/.gitignore" "$(BUILD_VENV)/.lock" "$(BUILD_VENV)/CACHEDIR.TAG"
	rm -f "$(BUILD_VENV)"/bin/activate "$(BUILD_VENV)"/bin/activate.* "$(BUILD_VENV)"/bin/deactivate.bat
	rm -f "$(BUILD_VENV)/bin/activate_this.py"

override_dh_auto_test:
	debian/tests/test-build-dependencies.sh
	debian/tests/validate-source-package.sh
	debian/tests/test-offline-install.sh
	debian/tests/test-desktop-icon-cleanup.sh
	debian/tests/test-postrm-cleanup.sh
	TEST_BUILD_VENV="$(BUILD_VENV)" debian/tests/test-starter-profile.sh
	debian/tests/test-system-profile-dir.sh
	"$(BUILD_VENV)/bin/bianbu-agent" --config "$(CURDIR)/config/development.yaml" --help >/dev/null

override_dh_auto_install:
	install -d "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime"
	cp -a "$(BUILD_VENV)" "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/venv"
	install -D -m 0755 debian/bianbu-agent-wrapper "$(PACKAGE_ROOT)/usr/bin/bianbu-agent"
	install -D -m 0755 debian/bianbu-agent-runtime-wrapper "$(PACKAGE_ROOT)/usr/bin/bianbu-agent-runtime"
	install -D -m 0755 debian/provision-user.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/provision-user.py"
	install -D -m 0755 scripts/provision-system-agent.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/provision-system-agent.py"
	install -D -m 0755 debian/render-starter-agent.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/render-starter-agent.py"
	install -D -m 0755 debian/runtime-admin-token.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/runtime-admin-token.py"
	install -D -m 0755 debian/bianbu-agent-runtime-token "$(PACKAGE_ROOT)/usr/bin/bianbu-agent-runtime-token"
	# 桌面入口与启动器已退役：`retired-bianbu-agent.desktop` 不是应用菜单项，只是
	# cleanup-retired-desktop-icon 用来判定「桌面副本是否原样」的逐字节参照。
	install -D -m 0644 debian/retired-bianbu-agent.desktop \
		"$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/retired-bianbu-agent.desktop"
	install -D -m 0755 debian/cleanup-retired-desktop-icon "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/cleanup-retired-desktop-icon"
	install -D -m 0755 debian/runtime-user-entrypoint "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/runtime-user-entrypoint"
	install -D -m 0755 debian/prepare-runtime-device "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/prepare-runtime-device"
	install -D -m 0755 debian/configure-runtime-service-user "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/configure-runtime-service-user"
	if [ -f scripts/syscall-ebpf-collector.py ]; then install -D -m 0755 scripts/syscall-ebpf-collector.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/syscall-ebpf-collector.py"; fi
	if [ -f scripts/syscall-auditd-collector.py ]; then install -D -m 0755 scripts/syscall-auditd-collector.py "$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime/syscall-auditd-collector.py"; fi
	# One system-level Runtime service per device: it starts at boot and runs as
	# the device user resolved by postinst, so nothing depends on who logs in.
	install -D -m 0644 'debian/bianbu-agent-runtime.service' \
		'$(PACKAGE_ROOT)/usr/lib/systemd/system/bianbu-agent-runtime.service'
	# The Runtime units depend on this one, so the device prepares live state
	# at start instead of during unpack.
	install -D -m 0644 debian/bianbu-agent-runtime-register.service \
		"$(PACKAGE_ROOT)/usr/lib/systemd/system/bianbu-agent-runtime-register.service"
	install -D -m 0644 debian/bianbu-agent-runtime-keepalive.service \
		"$(PACKAGE_ROOT)/usr/lib/systemd/system/bianbu-agent-runtime-keepalive.service"
	install -D -m 0644 debian/bianbu-agent-runtime-keepalive.timer \
		"$(PACKAGE_ROOT)/usr/lib/systemd/system/bianbu-agent-runtime-keepalive.timer"
	install -D -m 0644 debian/bianbu-agent-runtime.polkit \
		"$(PACKAGE_ROOT)/usr/share/polkit-1/rules.d/60-bianbu-agent-runtime.rules"
	install -D -m 0644 debian/bianbu-agent-runtime.tmpfiles \
		"$(PACKAGE_ROOT)/usr/lib/tmpfiles.d/bianbu-agent-runtime.conf"
	# resources/ mirrors the installed resource root, so shipping it is one
	# copy.  Its README describes the source layout and stays behind.
	install -d "$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime"
	cp -a resources/. "$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime/"
	rm -f "$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime/README.md"
	# A resource kind keeps its directory even when the package ships no entry
	# for it, so a reader never has to tell "absent" from "unsupported".
	for kind in agents mcps models plugins skills; do \
		install -d "$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime/$$kind"; \
	done
	# The starter Agent template is rendered: the deploy-time model selection
	# replaces the source default so a device never publishes the placeholder.
	for agent in resources/agents/*/agent.yaml; do \
		agent_id="$$(basename "$$(dirname "$$agent")")"; \
		"$(BUILD_VENV)/bin/python" debian/render-starter-agent.py \
			"$$agent" \
			"$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime/agents/$$agent_id/agent.yaml"; \
	done
	# Command Hooks, the Worker and its tools are separate Python processes,
	# and the service runs with PYTHONDONTWRITEBYTECODE=1 against a root-owned
	# read-only /usr/lib.  Without shipped bytecode every process re-compiles
	# every imported module on every start (measured on K3: an intent Hook goes
	# 2.08s -> 1.04s, `import fastapi/pydantic/uvicorn` 3.30s -> ~1.00s).
	# Only the venv is compiled: pre-compiling the Hook scripts themselves
	# measured within noise, and the resource tree is a validated package tree
	# where a stray __pycache__ next to plugin.yaml makes the Plugin unreadable.
	# -s/-p (compileall rejects -d together with -s) rewrite the bytecode copied
	# from the build tree so co_filename is the absolute installation path
	# (/usr/lib/...), never the build directory: tracebacks keep resolving their
	# source lines on the device while the build path does not leak.
	find "$(PACKAGE_ROOT)/usr/share/bianbu-agent-runtime" -type d -name __pycache__ -prune -exec rm -rf '{}' +
	env -u PYTHONDONTWRITEBYTECODE "$(BUILD_VENV)/bin/python" -m compileall -q -f \
		-j "$$(nproc)" -s "$(PACKAGE_ROOT)" -p / \
		"$(PACKAGE_ROOT)/usr/lib/bianbu-agent-runtime"

override_dh_installsystemd:
	dh_installsystemd --name=bianbu-agent-runtime --no-enable --no-start
	dh_installsystemd --name=bianbu-agent-runtime-register --no-enable --no-start
	dh_installsystemd --name=bianbu-agent-runtime-keepalive --no-start

# Native extensions come from upstream wheels and must not be rewritten or
# split into a Debian debug package.
override_dh_dwz:

override_dh_strip:
